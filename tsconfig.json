{
  "compileOnSave": false,
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "module": "es2020",
    "outDir": "./dist/out-tsc",
    "paths": {
      "@test-options": [
        "./src/config/test-options.ts"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@api/*": [
        "./src/api/*"
      ],
      "@services/*": [
        "./src/api/services/*"
      ],
      "@controllers/*": [
        "./src/api/controllers/*"
      ],
      "@schemas/*": [
        "./src/data/schemas/*"
      ],
      "@factories/*": [
        "./src/data/factories/*"
      ],
      "@ui/*": [
        "./src/ui/*"
      ],
      "@pages/*": [
        "./src/ui/page-objects/*"
      ],
      "@elements/*": [
        "./src/ui/page-elements/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ]
    },
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "target": "es2020",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "plugins": [
      {
        "name": "tslint-language-service"
      }
    ]
  }
}